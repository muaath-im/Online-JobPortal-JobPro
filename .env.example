# Placeholders only. This file is documentation, not an automatically loaded .env.
# Use host environment settings or ignored PHP configuration; never commit secrets.
DB_HOST=your_host_mysql_hostname
DB_PORT=3306
DB_NAME=your_host_database_name
DB_USER=your_host_database_user
DB_PASS=replace_privately
# Optional absolute path to an existing PHP connector defining $mysqli:
JOBPRO_DB_CONFIG=
JOBPRO_MAIL_CONFIG=
JOBPRO_MAIL_TRANSPORT=disabled
JOBPRO_MAIL_BASE_URL=https://YOUR-PHP-APP.example
JOBPRO_MAIL_API_KEY=
JOBPRO_MAIL_FROM_ADDRESS=sender@example.invalid
JOBPRO_MAIL_FROM_NAME=JobPro
JOBPRO_MAIL_CONTACT_TO=owner@example.invalid
# Optional absolute private storage path; existing local state is retained by default.
JOBPRO_AUTH_STORAGE=
